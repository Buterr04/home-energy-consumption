# SQLite file used by the API. Leave unset to use <project>/app.db.
# DATABASE_URL=sqlite:///./app.db

JWT_SECRET=replace-this-secret-with-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Pretrained two-stage linear model loaded at startup.
# LINEAR_MODEL_DIR=models/linear-v1
MODEL_VERSION=linear-v1

# Optional explicit dataset path for bootstrap/import/training.
# DATASET_PATH=../Technical Project/Technical Project/household_electricity_consumption.csv

# JSON array, parsed by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
